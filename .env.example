# Copy to .env.local for local development.
# Leave the Supabase values empty to run in "local mode" (accounts and scores
# are kept in this browser only - handy for trying the quizzes offline).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only used to show the Admin link early; the database decides who is admin.
VITE_ADMIN_USERNAME=Radmud

# Domain used for the hidden fake emails (<username>@<domain>). Must match
# what existing accounts were created with - don't change it after launch.
VITE_AUTH_EMAIL_DOMAIN=geoquiz.local
